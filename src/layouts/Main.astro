---
import "../styles/global.css";

const {
    title = "Zaden Maestas",
    description = "Fullstack developer focused on building scalable, maintainable software across backend systems, frontend applications, and Linux-based environments.",
} = Astro.props;
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <script src="https://kit.fontawesome.com/de4933ee66.js" crossorigin="anonymous"></script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
        if (!document.cookie.split(';').some(c => c.trim() === 'theme=light')) {
            document.documentElement.classList.add('dark-theme');
        }
    </script>
</head>
<body>
    <slot />
</body>
</html>
