---
const { showContact = true } = Astro.props;
---

<footer>
    <div class="container">
        <div class="row footer__row">
            <a href="/" class="footer__anchor">
                <figure class="footer__logo">
                    <img src="/assets/logo.svg" class="footer__logo--img" alt="Zaden Maestas logo">
                </figure>
                <span class="footer__logo--popper">
                    Top
                    <i class="fas fa-arrow-up"></i>
                </span>
            </a>
            <div class="footer__social--list">
                <a target="_blank" href="https://github.com/ZadenMaestas" class="footer__social--link link__hover-effect link__hover-effect--white">
                    GitHub
                </a>
                <a href="https://www.linkedin.com/in/zaden-maestas-803b62277/" target="_blank" class="footer__social--link link__hover-effect link__hover-effect--white">
                    LinkedIn
                </a>
                {showContact ? (
                    <a href="#" data-modal-trigger data-scroll-top class="footer__social--link link__hover-effect link__hover-effect--white">
                        Contact
                    </a>
                ) : (
                    <a href="mailto:zadenmaestasdev@gmail.com" class="footer__social--link link__hover-effect link__hover-effect--white">
                        Contact
                    </a>
                )}
                <a href="/assets/zaden-maestas-resume.pdf" target="_blank" class="footer__social--link link__hover-effect link__hover-effect--white">
                    Resume
                </a>
            </div>
            <div class="footer__copyright">Copyright &copy; 2026 Zaden Maestas</div>
        </div>
    </div>
</footer>
