---
const { page = "home" } = Astro.props;
const isHome = page === "home";
---

<nav>
    <figure>
        <a href="/">
            <img id="personal-logo" src="/assets/logo.svg" alt="Zaden Maestas logo">
        </a>
    </figure>
    <ul class="nav__link--list">
        {isHome ? (
            <li class="nav__link" data-modal-trigger>
                <a href="#" class="nav__link--anchor link__hover-effect link__hover-effect--black">About</a>
            </li>
        ) : (
            <li class="nav__link">
                <a href="/#about" class="nav__link--anchor link__hover-effect link__hover-effect--black">About</a>
            </li>
        )}
        <li class="nav__link">
            <a href="/#projects" class="nav__link--anchor link__hover-effect link__hover-effect--black">Projects</a>
        </li>
        <li class="nav__link">
            <a href="/blog" class="nav__link--anchor link__hover-effect link__hover-effect--black">Blog</a>
        </li>
        {isHome ? (
            <li class="nav__link" data-modal-trigger>
                <a href="#" class="nav__link--anchor link__hover-effect link__hover-effect--black">Contact</a>
            </li>
        ) : (
            <li class="nav__link">
                <a href="mailto:zadenmaestasdev@gmail.com" class="nav__link--anchor link__hover-effect link__hover-effect--black">Contact</a>
            </li>
        )}
        <li class="nav__link click" id="contrast-toggle">
            <a href="#" class="nav__link--anchor link__hover-effect link__hover-effect--black">
                <i class="fas fa-adjust"></i>
            </a>
        </li>
    </ul>
</nav>

<script>
    document.getElementById('contrast-toggle')?.addEventListener('click', (e) => {
        e.preventDefault();
        const isDark = document.documentElement.classList.toggle('dark-theme');
        document.cookie = isDark
            ? 'theme=;path=/;max-age=0'
            : 'theme=light;path=/;max-age=31536000;SameSite=Lax';
    });
</script>
